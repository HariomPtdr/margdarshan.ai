# Mistral (free tier: https://console.mistral.ai)
MISTRAL_API_KEY=your-mistral-key

# LocationIQ (free tier 5k/day: https://locationiq.com/)
LOCATIONIQ_API_KEY=pk.

# Postgres
POSTGRES_USER=grievance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=grievance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me

# Service URLs (internal docker network)
CHATBOT_URL=http://service-chatbot:8001
LOCATION_URL=http://service-location:8002
NLU_URL=http://service-nlu:8003
CLASSIFIER_URL=http://service-classifier:8004
ROUTING_URL=http://service-routing:8005
SUBMISSION_URL=http://service-submission:8006
TRACKER_URL=http://service-tracker:8007

# Frontend
VITE_GATEWAY_URL=http://localhost:8000

# WhatsApp (provider: mock | twilio | meta)
WHATSAPP_PROVIDER=mock
# Twilio sandbox creds (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta WhatsApp Cloud API (production)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
# Verify token for the inbound webhook (set in provider console too)
WHATSAPP_VERIFY_TOKEN=change-me
